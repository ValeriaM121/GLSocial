// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User{
  id                  String  @id @default(uuid())
  username            String? @unique
  email               String  @unique
  password            String?
  confirmPassword     String?
  googleId            String? @unique
  name                String?
  avatar              String?


  createdAT           DateTime @default(now())

  watchlistShowsItems WatchlistShowsItem[]

  watchlistMoviesItems WatchlistMoviesItem[]

  passwordResetTokens PasswordResetToken[]

  refreshTokens RefreshToken[]
}

model RefreshToken{
  id              String @id @default(uuid())
  tokenHash       String @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  deviceName      String?
  lastUsedAt      DateTime?

  revokedAt       DateTime?

  userId          String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade) 
}

model PasswordResetToken{
  id          String @id @default(uuid())
  userId      String
  token       String @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ShowSource {
  TMDB
  MANUAL
}

model Show{
  id              String @id @default(uuid())
 
  tmdbId          Int? @unique
  title           String
  originalTitle   String?
  overview        String?
  releaseYear     Int
  genres          String[] @default([])
  seasons         Int?
  episodes        Int?
  posterURL       String?
  createdBy       String
  createdAt       DateTime @default(now())

  isGL            Boolean @default(true)
  source          ShowSource @default(TMDB)


  watchlistShowsItems WatchlistShowsItem[]

  onboardingShows OnboardingShow[]
}

model OnboardingShow{
  id              String @id @default(uuid())
  showId          String @unique
  position        Int
  active          Boolean @default(true)

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade )
}


model Movies{
  id            String @id @default(uuid())
  title         String
  overview      String?
  releaseYear   Int
  genres        String[] @default([])
  runtime       Int?
  posterURL     String?
  createdAt     DateTime @default(now())

  watchlistMoviesItems WatchlistMoviesItem[]
}

enum WatchlistStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}

model WatchlistShowsItem{
  id          String @id @default(uuid())
  userID      String
  showID      String
  status      WatchlistStatus @default(PLANNED)
  rating      Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showID], references: [id], onDelete: Cascade )

  @@unique([userID, showID])
}

model WatchlistMoviesItem{
  id          String @id @default(uuid())
  userID      String
  movieID     String
  status      WatchlistStatus @default(PLANNED)
  rating      Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)
  show Movies @relation(fields: [movieID], references: [id], onDelete: Cascade )
}